#!/bin/sh
# LATTICE pre-commit gate.
#
# The legacy project built a full set of zero-lock checkers and then never wired
# them into the commit path, so every check relied on someone remembering to run it
# by hand. Its own handoff notes record that the hook file "was installed" but was a
# /bin/sh script on a machine where sh.exe cannot start, so it never actually ran.
#
# This hook is deliberately written in a form that works here: it shells out to
# Python, and it fails closed (any error reds the commit).

set -e

ROOT="$(git rev-parse --show-toplevel)"
# This repository's root IS the Lean project root, so the gate sits at `gov/gate.py`
# directly beneath it. The previous version was written for the legacy layout, where
# the gate lived under `zero/gov/`; copied verbatim it failed closed with
# "zero: not found" on every commit. Verified by running the installed hook.
GOV="$ROOT/gov"

if [ ! -d "$GOV" ]; then
  echo "gov: not found at $GOV -- refusing to commit" >&2
  exit 1
fi

PY=python
if ! command -v "$PY" >/dev/null 2>&1; then
  PY=python3
fi

echo "lattice: running invariant gate..."
"$PY" "$GOV/gate.py"

echo "lattice: gate passed"
